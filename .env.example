# Copy this file to .env.local and fill values. Names only, never commit values (section 13).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
ADMIN_EMAIL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=           # app sign-in
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=             # 32 random bytes, base64
# D11/Q12: ENCRYPTION_KEY also keys the suppression hashes, so rotating it silently
# invalidates the do-not-contact list. Q12 proposes a dedicated key; until the owner
# answers, only this line exists, commented out, so no half-wired secret is loaded.
# SUPPRESSION_HASH_KEY=     # 32 random bytes, base64 (only after Q12 is answered)
OWNER_TIMEZONE=
# DRY_RUN=true rewrites every send to DRY_RUN_REDIRECT_EMAIL and tags it as a test.
# Required true unless VERCEL_ENV=production; the app refuses to boot otherwise (section 8).
DRY_RUN=true
DRY_RUN_REDIRECT_EMAIL=     # required whenever DRY_RUN=true; use a mailbox you own
# Vercel sets VERCEL_ENV automatically ("production" | "preview" | "development").
# Leave it unset locally; unset counts as non-production, so DRY_RUN must stay true.
# In Vercel: Preview keeps DRY_RUN=true + redirect; Production must set DRY_RUN=false,
# or the app refuses to boot rather than silently redirecting real outreach.
VERCEL_ENV=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Local development only (never set these in production)
# ---------------------------------------------------------------------------
# DECISIONS.md D2: with DRY_RUN=true and NODE_ENV !== production, Scout enables a
# dev-only email+password sign-in so the app is usable before Google OAuth exists.
DEV_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=
# Local test fixture (docker-compose.yml; see docs/testing.md): postgres:17 on host port
# 55432, user/password scout/scout, database scout_test. Tests truncate every domain table,
# so never point it at real data. Vitest reads the process environment, not .env.local;
# export DATABASE_URL before `pnpm test` / `pnpm test:workflows`.
# DATABASE_URL=postgres://scout:scout@localhost:55432/scout_test

# ---------------------------------------------------------------------------
# Mailbox (Gmail API, Internal OAuth app)
# ---------------------------------------------------------------------------
SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_SECRET=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
# Both ids are required now (section 4: "IDs live in env, never hard-coded").
# Get current ids with `pnpm tsx scripts/refresh-models.ts`; Claude Haiku 4.5 is the v1
# copy model and a Gemini Flash id from the free tier is the research model.
MODEL_COPY=
GEMINI_API_KEY=             # free tier, company research only
MODEL_RESEARCH=

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
APOLLO_API_KEY=
EXA_API_KEY=
REOON_API_KEY=
ZEROBOUNCE_API_KEY=

# ---------------------------------------------------------------------------
# Quotas (section 0)
# ---------------------------------------------------------------------------
DAILY_NEW_PROSPECTS=5
MAX_DAILY_NEW_PROSPECTS=12
DAILY_EMAIL_CAP=50
DAILY_LINKEDIN_TASKS=10
DAILY_EXA_SEARCHES=45
DAILY_VERIFICATIONS=23
MONTHLY_AI_BUDGET_USD=5
LINKEDIN_MODE=assisted      # locked for v1

# ---------------------------------------------------------------------------
# Alerts and meetings
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALCOM_BOOKING_URL=
CALCOM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
