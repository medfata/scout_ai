    "eval:scorer": "promptfoo eval -c evals/promptfooconfig.scorer.yaml",
    "eval:copy": "promptfoo eval -c evals/promptfooconfig.copywriter.yaml",
    "eval:classifier": "promptfoo eval -c evals/promptfooconfig.classifier.yaml",
